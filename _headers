# Cloudflare Pages headers for yourtownpros.com (runbook: rankly-plan/cloudflare-cutover-runbook-2026-11-13.md)
# GitHub Pages ignores this file. Verified by curl on the pages.dev preview before cutover.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=2592000

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

/sitemap.xml
  Cache-Control: public, max-age=300, must-revalidate

/sitemap-priority.xml
  Cache-Control: public, max-age=300, must-revalidate

/robots.txt
  Cache-Control: public, max-age=300, must-revalidate

/55051a1a62ab0c1d6b1547cc3c6a66d8.txt
  Cache-Control: public, max-age=300, must-revalidate
